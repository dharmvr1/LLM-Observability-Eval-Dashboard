# Copy this file to .env and fill in the keys you have. Never commit .env.
# Use plain names (letters, digits, underscore): the shell cannot read a name with hyphens.

GROQ_API_KEY=
OPENROUTER_API_KEY=
Gemini_API_KEY=

# Optional: the local freellmapi gateway (http://localhost:3001/v1). Used by `make eval GATEWAY=1`.
FREELLMAPI_KEY=

# Optional overrides for the judge LLM (the defaults are Groq):
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=openai/gpt-oss-20b
# PII_JUDGE_MODEL=openai/gpt-oss-120b
# JUDGE_DAILY_TOKEN_BUDGET=150000
