.env
.env.*
!.env.example
!.env.compose
.envrc
*.pem
*.key
*.p12

# ---- Python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

